// Generated by CMake from BuildInfo.h.in: what this build is, for the About dialog and bug reports.
#pragma once

namespace vellora::buildinfo {

// The workspace version (Cargo.toml), also the application's version.
inline constexpr const char* kVersion = "@VELLORA_VERSION@";
// The git commit the build was configured from, with "+dirty" if the tree had changes ("unknown"
// outside a git checkout). Fixed when CMake runs, so reconfigure after committing.
inline constexpr const char* kCommit = "@VELLORA_COMMIT@";
// The day CMake ran, UTC (or SOURCE_DATE_EPOCH, for reproducible builds).
inline constexpr const char* kBuildDate = "@VELLORA_BUILD_DATE@";
// The project's home on GitHub (Cargo.toml), where bug reports go.
inline constexpr const char* kRepository = "@VELLORA_REPOSITORY@";

} // namespace vellora::buildinfo